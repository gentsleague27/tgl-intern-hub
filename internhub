  <script>
    function switchTab(tabName, event) {
      if (event) {
        event.preventDefault();
      }

      const sections = ['dashboard', 'breakdown', 'roadmap', 'resources', 'evaluation'];

      sections.forEach(s => {
        const view = document.getElementById('view-' + s);
        const tab = document.getElementById('tab-' + s);
        if (view) view.classList.add('hidden');
        if (tab) tab.classList.remove('active-tab');
      });

      const activeView = document.getElementById('view-' + tabName);
      const activeTab = document.getElementById('tab-' + tabName);

      if (activeView) activeView.classList.remove('hidden');
      if (activeTab) activeTab.classList.add('active-tab');

      // Sync location hash without triggering reload
      if (history.pushState) {
        history.pushState(null, null, '#' + tabName);
      } else {
        location.hash = '#' + tabName;
      }
    }

    // Load correct tab if URL contains a hash on page refresh
    window.addEventListener('DOMContentLoaded', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash && ['dashboard', 'breakdown', 'roadmap', 'resources', 'evaluation'].includes(hash)) {
        switchTab(hash);
      }
    });
  </script>
